{
  "name": "coco-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{vue,ts,js,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,json,css}\""
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.0",
    "vue-tsc": "^3.2.9"
  }
}
